{
  "private": true,
  "type": "module",
  "name": "ani-altstore-source",
  "version": "0.0.0",
  "description": "Altstore source for Animeko",
  "homepage": "https://github.com/maxchang3/ani-altstore-source#readme",
  "bugs": "https://github.com/maxchang3/ani-altstore-source/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxchang3/ani-altstore-source.git"
  },
  "license": "MIT",
  "author": "maxchang3",
  "scripts": {
    "generate": "bun run src/index.ts",
    "generate:reprobe": "bun run src/index.ts --reprobe",
    "verify": "bun run src/verify.ts",
    "test": "bun test",
    "lint": "biome check",
    "lint:fix": "biome check --write .",
    "prepare": "simple-git-hooks",
    "typecheck": "tsc --noEmit"
  },
  "simple-git-hooks": {
    "pre-commit": "bun install --frozen-lockfile --ignore-scripts && bunx lint-staged"
  },
  "lint-staged": {
    "*": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@maxchang/biome-config": "^0.1.8",
    "@types/bun": "latest",
    "@types/plist": "^3.0.5",
    "@types/semver": "^7.8.0",
    "lint-staged": "^16.2.7",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.8",
  "dependencies": {
    "bplist-parser": "^0.5.0",
    "fflate": "^0.8.3",
    "listr2": "^11.1.1",
    "plist": "^3.1.0",
    "semver": "^7.8.5"
  }
}
